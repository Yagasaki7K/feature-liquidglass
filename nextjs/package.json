{
    "name": "nextjs",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack",
        "vercel": "next build",
        "start": "next start",
        "lint": "next lint",
        "commit": "git pull && bun run vercel && read -p 'Descriptions Commit: ' message && git add . && echo -n \"$message - \" && node getTime.js | xargs -I {} git commit -m \"$message - {}\" && git push",
        "clean": "rm -rf node_modules && bun install"
    },
    "dependencies": {
        "eslint-config-next": "^16.0.7",
        "next": "^16.0.7",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "styled-components": "^6.1.18"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.1.1",
        "@types/node": "^20.19.0",
        "@types/react": "^19.1.7",
        "@types/react-dom": "^19.1.6",
        "typescript": "^5.8.3"
    }
}
